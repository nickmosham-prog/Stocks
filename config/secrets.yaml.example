# Copy this file to config/secrets.yaml and fill in real values.
# config/secrets.yaml is git-ignored - it will never be committed, even if
# you `git add -A`. Anything you put here is deep-merged over
# config/settings.yaml at load time, so you only need to list the keys
# you're overriding.
#
#   cp config/secrets.yaml.example config/secrets.yaml
#   # then edit config/secrets.yaml with your real App Password

alerts:
  email:
    from_address: "you@gmail.com"
    app_password: "xxxx xxxx xxxx xxxx"   # Gmail App Password, not your real password
    to_address: "you@gmail.com"
